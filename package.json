{
  "name": "az2aws",
  "version": "1.6.1",
  "description": "Use Azure AD SSO to log into the AWS CLI. A modern, actively maintained alternative to aws-azure-login.",
  "main": "lib/index.js",
  "author": {
    "name": "az2aws devs",
    "url": "https://github.com/az2aws"
  },
  "license": "MIT",
  "keywords": [
    "aws",
    "azure",
    "azure-ad",
    "entra-id",
    "microsoft-entra",
    "saml",
    "sso",
    "single-sign-on",
    "cli",
    "authentication",
    "mfa",
    "multi-factor-authentication",
    "federated-login",
    "aws-cli",
    "credential-helper",
    "sts",
    "assume-role",
    "puppeteer"
  ],
  "homepage": "https://github.com/kuma0128/az2aws#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuma0128/az2aws.git"
  },
  "bugs": "https://github.com/kuma0128/az2aws/issues",
  "engines": {
    "node": ">=24.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer"
    ],
    "overrides": {}
  },
  "bin": {
    "az2aws": "lib/index.js"
  },
  "scripts": {
    "start": "ts-node-dev src/index.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "eslint": "eslint .",
    "prettier:write": "prettier --write \"src/**/*.{ts,json}\"",
    "prettier:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm eslint && pnpm prettier:check"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1009.0",
    "@smithy/node-http-handler": "^4.4.16",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "https-proxy-agent": "^9.0.0",
    "ini": "^6.0.0",
    "inquirer": "^13.3.2",
    "puppeteer": "^24.39.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/ini": "^4.1.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.0"
  }
}
